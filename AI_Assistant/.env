# n8n version
N8N_VERSION=2.42.6

# Sandbox service version
N8N_SANDBOX_VERSION=1.7.0

# Task runners
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=4df5e74f8736da7916679ba1d5e41245

# Sandbox service secrets
SANDBOX_API_KEYS=api_key_n8n_local_secure_prod_991823
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=reg_token_local_123
SANDBOX_API_RUNNER_API_KEY=runner_key_local_123

SANDBOX_RUNNER_REGISTRATION_TOKEN=reg_token_local_123
SANDBOX_RUNNER_API_KEYS=runner_key_local_123

# n8n -> Sandbox connection
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_API_KEY=api_key_n8n_local_secure_prod_991823

# Web search: SearXNG
SEARXNG_SECRET=searxng_secret_local_search_882716
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# n8n AI Assistant Model (Ollama on Host via host-forwarded port 11435)
N8N_INSTANCE_AI_MODEL=openai/qwen2.5:32b
N8N_INSTANCE_AI_MODEL_URL=http://host.docker.internal:11435/v1
N8N_INSTANCE_AI_MODEL_API_KEY=ollama

# PostgreSQL
POSTGRES_USER=superuser
POSTGRES_PASSWORD=my-extra-password
POSTGRES_DB=n8n

# Podman compatibility
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false